{
  // El nom ha de coincidir amb el del Worker que ja tens al tauler de
  // Cloudflare. Si allà es diu d'una altra manera, canvia'l aquí.
  "name": "saunacat",

  // Punt d'entrada. És el que fa que Cloudflare deixi de veure el projecte
  // com «només fitxers estàtics» i, per tant, el que habilita les variables.
  "main": "src/index.js",

  "compatibility_date": "2026-08-14",

  // Tot el lloc web. Si una petició coincideix amb un fitxer d'aquí dins, es
  // serveix directament i el Worker ni s'executa.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // Les variables de text van AQUÍ i no al tauler: cada desplegament esborra
  // les que s'hagin definit allà. Els secrets, en canvi, es conserven sempre,
  // i per això RESEND_TOKEN no surt en aquest fitxer.
  //
  // Mentre el domini no estigui verificat a Resend, només et deixarà enviar
  // des d'onboarding@resend.dev i cap a l'adreça del teu compte. Per provar-ho
  // abans d'hora, canvia aquests dos valors, puja-ho, i desfés-ho després.
  "vars": {
    "CORREU_DESTI": "info@sauna.cat",
    "CORREU_ORIGEN": "web@sauna.cat"
  },

  "observability": {
    "enabled": true
  }
}
